HOST=127.0.0.1
PORT=8838
DATA_DIR=./data
# Local preview only. Set false and configure WeChat before any public deployment.
ALLOW_DEV_LOGIN=true
ADMIN_USERNAME=admin
# Set a strong password. If empty, first startup creates data/admin-bootstrap.txt.
ADMIN_PASSWORD=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# OpenAI-compatible chat completions and audio/speech adapters; other protocols can be added.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_THINKING=disabled
MEMORY_BASE_URL=
MEMORY_MODEL=
MEMORY_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_API_KEY=
TTS_VOICE=
TTS_PROVIDER=compatible
TTS_MODEL_VERSION=
TTS_ACCENT=unspecified
TTS_SPEED=1
TTS_WORKSPACE_ID=
TTS_REGION=
TTS_FORMAT=
TTS_SAMPLE_RATE=24000
# Must be set after provider and retention details are confirmed before production.
PRIVACY_POLICY_CONFIRMED=false
CONTENT_SAFETY_URL=
CONTENT_SAFETY_KEY=
