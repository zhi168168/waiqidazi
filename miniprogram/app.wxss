page{--accent:#187c65;--accent-soft:#eaf5ef;--surface:#fff;--canvas:#f7f9f8;--ink:#1d302b;--muted:#687a74;--line:#e9efec;background:var(--canvas);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;font-size:15px;line-height:1.65}
view,text,input,textarea,button,scroll-view{box-sizing:border-box}
button{display:flex;align-items:center;justify-content:center;min-height:48px;padding:20rpx 28rpx;font-size:14px;font-weight:600;line-height:1.5;border-radius:24rpx;background:var(--surface);color:var(--ink);margin:0;white-space:nowrap;transition:background .16s,opacity .16s}button::after{border:1rpx solid var(--line);border-radius:24rpx}button.primary{background:var(--accent);color:white}button.primary::after{border:0}button[disabled]{background:#eaf0ed;color:#889d94;opacity:1}button[disabled]::after{border:0}
input,textarea{font-family:inherit;width:100%;min-height:96rpx;border:1rpx solid var(--line);border-radius:24rpx;background:var(--surface);padding:24rpx;font-size:15px;color:var(--ink)}textarea{height:200rpx;line-height:1.65}
.page{padding:40rpx 48rpx 64rpx;max-width:1100rpx;margin:0 auto}.title{font-size:26px;font-weight:650;letter-spacing:-.5px;line-height:1.3;margin:12rpx 0 20rpx}.subtitle{color:var(--muted);font-size:13px;line-height:1.8;margin-bottom:40rpx}.panel{background:var(--surface);border:0;border-radius:32rpx;padding:32rpx;margin:24rpx 0}.section{font-size:16px;font-weight:600;margin:48rpx 0 24rpx}.muted{color:var(--muted);font-size:13px;line-height:1.75}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:20rpx 0}.row>input{flex:1;min-width:0}.label{font-size:13px;font-weight:500;color:var(--muted);margin:24rpx 0 12rpx}.empty{text-align:center;color:var(--muted);font-size:14px;line-height:1.8;padding:72rpx 24rpx}.link{color:var(--accent);font-size:13px;padding:16rpx 4rpx;min-width:44px;min-height:44px;display:inline-flex;align-items:center}.danger{color:#b34740}.badge{display:inline-block;font-size:12px;line-height:1.5;color:var(--accent);background:var(--accent-soft);padding:8rpx 16rpx;border-radius:12rpx}.hint{font-size:12px;color:var(--muted);line-height:1.75;margin:24rpx 0}.actions{display:flex;gap:16rpx;margin:24rpx 0}.actions button{flex:1;min-width:0;padding:20rpx 12rpx}.pre{white-space:pre-wrap;line-height:1.75;word-break:break-word}.list-row{padding:28rpx 0;border-bottom:1rpx solid var(--line)}.list-row:last-child{border:0}.list-title{font-size:16px;font-weight:600;margin:12rpx 0}.error{background:#fff0ec;color:#a33d36;padding:24rpx;border-radius:24rpx;margin:16rpx 0;font-size:13px;line-height:1.7}.tabs{display:flex;gap:12rpx;flex-wrap:wrap;margin:24rpx 0}.tab{display:flex;align-items:center;justify-content:center;min-height:44px;font-size:13px;padding:16rpx 24rpx;border-radius:20rpx;background:var(--surface);color:var(--muted);border:1rpx solid var(--line)}.tab.active{background:var(--accent-soft);border-color:var(--accent-soft);color:var(--accent);font-weight:600}.pressed{opacity:.65}
.menu-row{display:flex;align-items:center;justify-content:space-between;min-height:104rpx;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line)}.menu-row:last-child{border:0}.menu-leading{display:flex;align-items:center;gap:20rpx}.menu-icon{width:44rpx;height:44rpx}.chevron{width:28rpx;height:28rpx}.menu-caption{font-size:12px;color:var(--muted);margin-top:4rpx}.panel.menu-panel{padding:8rpx 28rpx}.search-field{background:var(--surface)}
@media (prefers-reduced-motion:reduce){button{transition:none}}
