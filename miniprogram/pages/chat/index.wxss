page{height:100%;overflow:hidden;background:var(--surface)}.chat-page{height:100%;display:flex;flex-direction:column;background:var(--surface)}
.chat-error{margin:12rpx 48rpx;flex-shrink:0}.messages{height:0;flex:1;min-height:0;width:100%;padding:0 48rpx;box-sizing:border-box}
.intro{padding:96rpx 0 48rpx;text-align:center}.intro-mark{width:128rpx;height:128rpx;border-radius:50%;margin-bottom:32rpx}.intro-title{font-size:28px;font-weight:650;letter-spacing:-.8px;line-height:1.3;margin-bottom:24rpx}.intro .subtitle{font-size:13px;line-height:1.85;margin:0 auto 64rpx;max-width:580rpx}.suggestion{display:flex;align-items:center;justify-content:space-between;gap:20rpx;background:var(--canvas);padding:28rpx 32rpx;border-radius:24rpx;font-size:14px;line-height:1.7;margin:20rpx 0;text-align:left;min-height:104rpx}.suggestion text{flex:1;min-width:0}.suggestion .chevron{flex-shrink:0;width:28rpx;height:28rpx;opacity:.65}
.turn{margin:32rpx 0 56rpx}.user-wrap{display:flex;justify-content:flex-end}.user-message{max-width:88%;background:var(--accent-soft);color:var(--ink);border-radius:36rpx 36rpx 8rpx 36rpx;padding:24rpx 32rpx;font-size:15px;line-height:1.7}.assistant-label{display:flex;align-items:center;gap:16rpx;font-size:13px;font-weight:600;color:var(--ink);margin:40rpx 0 24rpx}.assistant-label image{width:52rpx;height:52rpx;border-radius:50%;flex-shrink:0}.ai-label{font-size:11px;font-weight:400;color:var(--muted);margin-left:2rpx}.assistant-message{font-size:16px;line-height:1.75;word-break:break-word}.assistant-content{font-size:16px;line-height:1.75}.typing{display:flex;align-items:center;gap:10rpx;color:var(--muted);font-size:13px;min-height:52rpx}.typing-dot{width:8rpx;height:8rpx;border-radius:50%;background:var(--accent);animation:wait 1.4s ease-in-out infinite}.typing-dot:nth-child(2){animation-delay:.16s}.typing-dot:nth-child(3){animation-delay:.32s}.typing-label{margin-left:8rpx}
.composer{flex-shrink:0;padding:16rpx 32rpx 12rpx;background:var(--surface)}.composer-row{display:flex;align-items:flex-end;gap:16rpx;border:1rpx solid var(--line);border-radius:48rpx;background:var(--canvas);padding:12rpx}.composer textarea{flex:1;width:0;min-width:0;min-height:44px;max-height:220rpx;padding:20rpx 12rpx 16rpx 20rpx;border:0;background:transparent;border-radius:0;font-size:15px;line-height:1.6}.composer button{flex:0 0 88rpx;width:88rpx;min-width:44px;height:88rpx;min-height:44px;padding:0;margin:0;border-radius:50%}.composer button::after{border:0}.composer button image{width:44rpx;height:44rpx}.composer-note{text-align:center;font-size:11px;color:var(--muted);line-height:1.6;margin-top:12rpx}
.english-tip{margin:24rpx 0 0;padding:28rpx 32rpx 16rpx;background:#f2f7f3;border-radius:32rpx;color:var(--ink);word-break:break-word}.tip-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.tip-label{font-size:12px;font-weight:600;color:var(--accent)}.tip-copy{font-size:12px;padding:0 0 0 20rpx;min-height:44px}.tip-caption{font-size:12px;color:var(--muted);line-height:1.7;margin:0 0 20rpx}.tip-expression{font-size:18px;font-weight:500;line-height:1.6;white-space:pre-wrap;letter-spacing:-.2px}.tip-toggle{display:flex;align-items:center;justify-content:space-between;gap:8rpx;font-size:12px;color:var(--accent);min-height:44px;margin-top:16rpx}.tip-toggle image{width:24rpx;height:24rpx;opacity:.7}.tip-explanation{border-top:1rpx solid #dce8df;padding:24rpx 0 12rpx;font-size:13px;line-height:1.8;color:var(--muted)}
.reply-actions{display:flex;justify-content:flex-end;margin:8rpx 0 0}.language-button{width:44px;min-width:44px;min-height:44px;height:44px;padding:0;border:0;background:transparent;color:var(--muted);border-radius:12rpx}.language-button::after{border:0}.language-button.selected{color:var(--accent);background:var(--accent-soft)}.language-button[disabled]{background:transparent;color:var(--muted);opacity:.65}.language-icon{display:flex;align-items:center;justify-content:center;width:44rpx;height:32rpx;border:1rpx solid currentColor;border-radius:8rpx;font-size:10px;font-weight:600;line-height:1}.reply-english{border-top:1rpx solid var(--line);margin-top:24rpx;padding-top:24rpx}.english-version-label{font-size:12px;color:var(--accent);margin-bottom:16rpx;font-weight:600}.english-version-hint{font-size:13px;line-height:1.7}
@keyframes wait{0%,80%,100%{opacity:.3;transform:translateY(0)}40%{opacity:1;transform:translateY(-3px)}}
@media (prefers-reduced-motion:reduce){.typing-dot{animation:none}}
