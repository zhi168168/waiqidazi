<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{entry}}"><view class="title">{{entry.title}}</view><view class="row"><text class="badge">{{entry.channel}} · {{entry.formality}}</text></view><view class="subtitle">{{entry.situation}}</view><view class="expression pre">{{entry.english}}</view><view class="panel"><view class="pre">{{entry.chinese}}</view></view><view class="panel"><view class="row"><text>语料朗读</text><text class="badge">AI 语音</text></view><slider min="0" max="{{duration || 1}}" value="{{progress}}" activeColor="#187c65" bindchange="seek"/><view class="muted">{{progress}} / {{duration}} 秒</view><view class="actions"><button class="primary" bindtap="play">{{playing ? '暂停' : '播放'}}</button><button bindtap="replay">重播</button><button bindtap="speed">{{speed}}×</button></view></view><view class="actions"><button bindtap="copy">复制英文</button><button bindtap="favorite">{{favorite ? '取消收藏' : '收藏'}}</button></view><view class="section">使用说明</view><view class="muted pre">{{entry.notes || '暂无补充说明'}}</view><button class="primary" style="margin-top:40rpx" bindtap="practice">拿这条和搭子练习</button></block></view>
