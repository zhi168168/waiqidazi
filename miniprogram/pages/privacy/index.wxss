.privacy-page{padding-top:48rpx}.privacy-page .title{font-size:44rpx;margin-bottom:32rpx}.privacy-summary{color:var(--ink);font-size:29rpx;line-height:1.85}.privacy-summary view{margin-bottom:24rpx}.policy-link{background:transparent;color:var(--accent);padding:12rpx 0;margin:16rpx 0;text-align:left;font-size:28rpx}.policy-link::after,.decline::after{border:0}.policy-text{white-space:pre-wrap;font-size:27rpx;line-height:1.9;padding:28rpx;background:var(--surface);border-radius:24rpx;color:var(--ink)}.privacy-actions{margin-top:40rpx}.consent-label{display:flex;align-items:center;font-size:26rpx;color:var(--muted);margin-bottom:28rpx}.consent-label checkbox{transform:scale(.8);transform-origin:left center;margin-right:0}.privacy-actions .primary{border-radius:24rpx}.decline{background:transparent;color:var(--muted);font-size:28rpx;margin-top:16rpx}
