.library-page{background:var(--canvas);min-height:100%}.library-heading{margin:20rpx 0 48rpx}.library-heading .title{font-size:26px;margin:0 0 20rpx}.library-heading .subtitle{margin:0;font-size:13px;line-height:1.8}.scene-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx}.scene-button{display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-start;min-width:0;min-height:380rpx;padding:32rpx 28rpx;border-radius:40rpx;text-align:left;white-space:normal;background:var(--surface);transition:transform .16s,opacity .16s}.scene-button::after{border:0}.scene-icon{display:flex;align-items:center;justify-content:center;width:80rpx;height:80rpx;border-radius:24rpx;background:#eaf5ef;margin-bottom:36rpx}.scene-button.blue .scene-icon{background:#edf2f8}.scene-button.sand .scene-icon{background:#f9f2e5}.scene-button.violet .scene-icon{background:#f2eef8}.scene-icon image{width:44rpx;height:44rpx}.scene-name{font-size:18px;font-weight:600;color:var(--ink);line-height:1.4;margin-bottom:16rpx}.scene-description{font-size:12px;font-weight:400;line-height:1.8;color:var(--muted);max-width:100%;min-height:82rpx}.scene-action{display:flex;align-items:center;justify-content:space-between;width:100%;gap:8rpx;margin-top:24rpx;font-size:12px;font-weight:500;color:var(--accent)}.scene-action image{width:24rpx;height:24rpx;opacity:.6}.scene-pressed{transform:scale(.98);opacity:.8}
@media (prefers-reduced-motion:reduce){.scene-button{transition:none}.scene-pressed{transform:none}}
