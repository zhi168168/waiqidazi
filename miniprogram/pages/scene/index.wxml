<view class="page library-page"><view class="title">{{sceneName}}</view><view class="subtitle">{{sceneDescription}}</view><input class="search-field" placeholder="搜索表达或中文需求" aria-label="搜索语料" value="{{q}}" bindinput="input" bindconfirm="search"/><view wx:if="{{subs.length}}" class="tabs"><view class="tab {{!subcategory ? 'active' : ''}}" data-id="" bindtap="sub">全部细分</view><view wx:for="{{subs}}" wx:key="id" class="tab {{subcategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="sub">{{item.name}}</view></view><view class="row filters"><picker range="{{channels}}" bindchange="channel"><view class="filter-option">{{channel || '全部沟通方式'}}<image class="chevron" src="/assets/icons/down.png"/></view></picker><picker range="{{tones}}" bindchange="tone"><view class="filter-option">{{formality || '全部语气'}}<image class="chevron" src="/assets/icons/down.png"/></view></picker></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{entries}}" wx:key="id" class="corpus-item" hover-class="pressed" data-id="{{item.id}}" bindtap="detail"><view class="corpus-meta">{{item.channel}} · {{item.formality}}</view><view class="corpus-title-row"><view class="list-title">{{item.title}}</view><image class="chevron" src="/assets/icons/chevron.png"/></view><view class="muted">{{item.situation}}</view></view><view wx:if="{{!entries.length && !error}}" class="empty corpus-empty"><image class="empty-icon" src="/assets/icons/library-active.png"/><view class="list-title">{{loading ? '正在查找…' : '暂未找到语料'}}</view><view class="muted">{{loading ? '稍等一下，好表达马上就来。' : '试试其他关键词或细分类。'}}</view></view></view>