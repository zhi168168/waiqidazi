.filters{margin:16rpx 0 28rpx;gap:16rpx}.filter-option{display:flex;align-items:center;gap:8rpx;min-height:44px;color:var(--muted);font-size:13px}.filter-option .chevron{width:24rpx;height:24rpx}.corpus-item{padding:32rpx;background:var(--surface);border:0;border-radius:28rpx;margin:20rpx 0}.corpus-meta{font-size:12px;color:var(--accent)}.corpus-title-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:4rpx 0 12rpx}.corpus-title-row .list-title{font-size:17px;line-height:1.5}.corpus-title-row>.chevron{flex-shrink:0;opacity:.65}.corpus-empty{padding-top:80rpx}.empty-icon{width:72rpx;height:72rpx;opacity:.55;margin-bottom:24rpx}
