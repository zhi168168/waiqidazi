<view class="page"><view class="title">会话历史</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="panel"><view class="list-row" wx:for="{{sessions}}" wx:key="id"><view data-id="{{item.id}}" bindtap="open"><view class="list-title">{{item.title}}</view><view class="muted">{{item.updatedAt}} {{item.roleplay ? '· 模拟情境' : ''}}</view></view><view class="link danger" data-id="{{item.id}}" bindtap="remove">删除会话</view></view><view wx:if="{{!sessions.length}}" class="empty">还没有会话。和搭子聊聊今天的工作吧。</view></view></view>
