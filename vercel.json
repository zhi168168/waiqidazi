{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": { "api/[...path].mjs": { "maxDuration": 300 } },
  "rewrites": [
    { "source": "/audio/:path*", "destination": "/api/audio/:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/library", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/memory", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
