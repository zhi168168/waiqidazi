# Copy into a new .env for web development; do not overwrite existing credentials.
HOST=127.0.0.1
PORT=8838
DB_DRIVER=postgres
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres
DATABASE_SSL=true
AUDIO_STORAGE=supabase
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server only. Never prefix these secrets with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=buddy-audio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ALLOW_DEV_LOGIN=false
PRIVACY_POLICY_CONFIRMED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_THINKING=disabled
MEMORY_BASE_URL=
MEMORY_MODEL=
MEMORY_API_KEY=
TTS_PROVIDER=compatible
TTS_BASE_URL=
TTS_MODEL=
TTS_MODEL_VERSION=
TTS_API_KEY=
TTS_VOICE=
TTS_ACCENT=unspecified
TTS_SPEED=1
TTS_WORKSPACE_ID=
TTS_REGION=
TTS_FORMAT=
TTS_SAMPLE_RATE=24000
# Web deployment uses the HTTP moderation adapter, not the WeChat internal API.
CONTENT_SAFETY_PROVIDER=http
CONTENT_SAFETY_URL=
CONTENT_SAFETY_KEY=
